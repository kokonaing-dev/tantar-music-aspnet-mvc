@model LoginViewModel
@{ ViewData["Title"] = "Log In"; }

<div class="d-flex align-items-center justify-content-center" style="min-height:80vh">
    <div class="tantar-form-card w-100">
        <h1 class="text-center fw-bold mb-4">Log in to TANTAR</h1>

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold small text-uppercase"></label>
                <input asp-for="Email" class="form-control bg-dark border-secondary text-white" placeholder="Email address" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label fw-semibold small text-uppercase"></label>
                <input asp-for="Password" type="password" class="form-control bg-dark border-secondary text-white" placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
            </div>

            <button type="submit" class="btn btn-tantar w-100 py-2 rounded-pill fw-bold">Log In</button>
        </form>

        <hr class="border-secondary my-4" />
        <p class="text-center text-secondary small">
            Don't have an account? <a asp-action="Register" class="text-white">Sign up</a>
        </p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
