@model AlbumViewModel
@{ ViewData["Title"] = "New Album"; }

<div class="page-content">
    <div class="tantar-form-card" style="max-width:560px">
        <h1 class="fw-bold mb-4">New Album</h1>
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold"></label>
                <input asp-for="Title" class="form-control bg-dark border-secondary text-white" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ArtistId" class="form-label fw-semibold"></label>
                <select asp-for="ArtistId" asp-items="Model.Artists" class="form-select bg-dark border-secondary text-white">
                    <option value="">– Select artist –</option>
                </select>
                <span asp-validation-for="ArtistId" class="text-danger small"></span>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label asp-for="ReleaseDate" class="form-label fw-semibold"></label>
                    <input asp-for="ReleaseDate" type="date" class="form-control bg-dark border-secondary text-white" />
                </div>
                <div class="col">
                    <label asp-for="Genre" class="form-label fw-semibold"></label>
                    <input asp-for="Genre" class="form-control bg-dark border-secondary text-white" />
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="CoverImage" class="form-label fw-semibold"></label>
                <input asp-for="CoverImage" type="file" accept="image/*" class="form-control bg-dark border-secondary text-white" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-tantar px-4">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
