@model IEnumerable<AlbumDetailViewModel>
@{ ViewData["Title"] = "Albums"; bool isAdmin = User.IsInRole("Admin"); }

<div class="page-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0">Albums</h1>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-tantar">
                <i class="bi bi-plus me-1"></i>New Album
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <p class="text-secondary">No albums yet.</p>
    }
    else
    {
        <div class="grid-cards">
            @foreach (var album in Model)
            {
                <div class="tantar-card">
                    <a asp-action="Details" asp-route-id="@album.Id" class="card-link">
                        <img src="@(album.CoverImagePath ?? "/images/default-cover.svg")"
                             alt="@album.Title" class="tantar-card-cover" />
                        <div class="fw-semibold text-truncate text-white">@album.Title</div>
                        <div class="small text-secondary text-truncate">@album.ArtistName · @album.ReleaseDate.Year</div>
                    </a>

                    @if (isAdmin)
                    {
                        <div class="card-admin-actions">
                            <a asp-action="Edit" asp-route-id="@album.Id" class="btn-card-action">
                                <i class="bi bi-pencil-fill"></i>Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@album.Id" method="post"
                                  onsubmit="return confirm('Delete «@album.Title»?')" style="flex:1">
                                <button type="submit" class="btn-card-action btn-card-delete w-100">
                                    <i class="bi bi-trash-fill"></i>Delete
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>
