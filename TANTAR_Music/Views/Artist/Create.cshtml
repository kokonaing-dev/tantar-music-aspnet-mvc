@model ArtistViewModel
@{ ViewData["Title"] = "New Artist"; }

<div class="page-content">
    <div class="tantar-form-card">
        <h1 class="fw-bold mb-4">New Artist</h1>
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control bg-dark border-secondary text-white" placeholder="Artist name" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Bio" class="form-label fw-semibold"></label>
                <textarea asp-for="Bio" rows="3" class="form-control bg-dark border-secondary text-white" placeholder="Short bio…"></textarea>
            </div>
            <div class="mb-4">
                <label asp-for="Image" class="form-label fw-semibold">Profile Image</label>
                <input asp-for="Image" type="file" accept="image/*" class="form-control bg-dark border-secondary text-white" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-tantar px-4">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
