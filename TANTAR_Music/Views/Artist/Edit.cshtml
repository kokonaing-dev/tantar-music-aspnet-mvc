@model ArtistViewModel
@{ ViewData["Title"] = "Edit Artist"; }

<div class="page-content">
    <div class="tantar-form-card">
        <h1 class="fw-bold mb-4">Edit Artist</h1>
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingImagePath" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control bg-dark border-secondary text-white" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Bio" class="form-label fw-semibold"></label>
                <textarea asp-for="Bio" rows="3" class="form-control bg-dark border-secondary text-white"></textarea>
            </div>
            <div class="mb-4">
                <label asp-for="Image" class="form-label fw-semibold">Replace Image</label>
                @if (Model.ExistingImagePath != null)
                {
                    <img src="@Model.ExistingImagePath" class="d-block mb-2 rounded-circle" style="height:80px;width:80px;object-fit:cover" alt="Current" />
                }
                <input asp-for="Image" type="file" accept="image/*" class="form-control bg-dark border-secondary text-white" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-tantar px-4">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
        <hr class="border-secondary my-4" />
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Delete this artist?')">
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash me-1"></i>Delete Artist
            </button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
