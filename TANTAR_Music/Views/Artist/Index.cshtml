@model IEnumerable<ArtistDetailViewModel>
@{ ViewData["Title"] = "Artists"; bool isAdmin = User.IsInRole("Admin"); }

<div class="page-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0">Artists</h1>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-tantar">
                <i class="bi bi-plus me-1"></i>New Artist
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <p class="text-secondary">No artists yet.</p>
    }
    else
    {
        <div class="grid-cards">
            @foreach (var artist in Model)
            {
                <div class="tantar-card text-center">
                    <a asp-action="Details" asp-route-id="@artist.Id" class="card-link">
                        <img src="@(artist.ImagePath ?? "/images/default-artist.svg")"
                             alt="@artist.Name" class="tantar-card-cover rounded-circle" />
                        <div class="fw-semibold text-truncate text-white">@artist.Name</div>
                        <div class="small text-secondary">Artist</div>
                    </a>

                    @if (isAdmin)
                    {
                        <div class="card-admin-actions">
                            <a asp-action="Edit" asp-route-id="@artist.Id" class="btn-card-action">
                                <i class="bi bi-pencil-fill"></i>Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@artist.Id" method="post"
                                  onsubmit="return confirm('Delete «@artist.Name»?')" style="flex:1">
                                <button type="submit" class="btn-card-action btn-card-delete w-100">
                                    <i class="bi bi-trash-fill"></i>Delete
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>
