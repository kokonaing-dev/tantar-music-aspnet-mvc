@model PlaylistDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    bool isOwner = ViewBag.IsOwner == true;
    bool isAuth = User.Identity?.IsAuthenticated == true;
}

<div class="page-content">
    <!-- Hero -->
    <div class="d-flex align-items-end gap-4 mb-4 pb-3 border-bottom border-secondary">
        <img src="@(Model.CoverImagePath ?? "/images/default-cover.svg")"
             alt="@Model.Name" class="rounded shadow"
             style="width:180px;height:180px;object-fit:cover;flex-shrink:0" />
        <div>
            <div class="text-secondary small text-uppercase fw-bold">
                @(Model.IsPublic ? "Public Playlist" : "Private Playlist")
            </div>
            <h1 class="fw-bold mb-1">@Model.Name</h1>
            @if (Model.Description != null) { <p class="text-secondary">@Model.Description</p> }
            <div class="text-secondary small">
                by @Model.OwnerName · @Model.Songs.Count song@(Model.Songs.Count != 1 ? "s" : "")
            </div>
            @if (isOwner)
            {
                <div class="mt-3 d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Delete this playlist?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

    @if (!Model.Songs.Any())
    {
        <div class="text-center py-4">
            <p class="text-secondary">No songs yet.</p>
            @if (isOwner)
            {
                <a asp-controller="Song" asp-action="Index" class="btn btn-outline-light btn-sm">
                    Browse songs to add
                </a>
            }
        </div>
    }
    else
    {
        <div class="mb-2 text-secondary small px-4">
            <div class="song-row has-actions">
                <span>#</span><span></span><span>Title</span><span>Album</span>
                <span></span><span class="text-end">Duration</span><span></span>
            </div>
            <hr class="border-secondary opacity-25 mt-1 mb-0" />
        </div>
        <div data-queue="playlist-songs">
            @{ int i = 0; }
            @foreach (var s in Model.Songs)
            {
                i++;
                <div class="song-row has-actions" data-queue-context="true">
                    <span class="song-num text-secondary text-center">@i</span>
                    <button class="song-play btn btn-link p-0 text-white align-items-center justify-content-center"
                            data-play="@s.FilePath" data-song-id="@s.Id"
                            data-title="@s.Title" data-artist="@s.ArtistName"
                            data-cover="@(s.CoverImagePath ?? "")">
                        <i class="bi bi-play-fill"></i>
                    </button>
                    <img src="@(s.CoverImagePath ?? "/images/default-cover.svg")" alt=""
                         class="rounded" style="width:40px;height:40px;object-fit:cover" />
                    <div class="overflow-hidden">
                        <div class="song-title fw-semibold text-truncate">@s.Title</div>
                        <div class="text-secondary small text-truncate">@s.ArtistName</div>
                    </div>
                    <span class="text-secondary small text-truncate">@(s.AlbumTitle ?? "–")</span>
                    <span></span>
                    <span class="text-secondary small text-end">@s.FormattedDuration</span>

                    <!-- Owner always sees the ... menu; non-owner auth user sees add-to-playlist -->
                    <div class="dropdown d-flex justify-content-end">
                        <button class="btn btn-link p-0 song-actions-btn"
                                data-bs-toggle="dropdown" title="More options">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                            @if (isAuth && !isOwner)
                            {
                                <li>
                                    <button class="dropdown-item" data-add-to-playlist="@s.Id">
                                        <i class="bi bi-plus-circle me-2"></i>Add to my playlist
                                    </button>
                                </li>
                            }
                            @if (isOwner)
                            {
                                <li>
                                    <button class="dropdown-item text-danger"
                                            data-remove-from-playlist="@s.Id"
                                            data-playlist-id="@Model.Id">
                                        <i class="bi bi-x-circle me-2"></i>Remove from playlist
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    }
</div>
