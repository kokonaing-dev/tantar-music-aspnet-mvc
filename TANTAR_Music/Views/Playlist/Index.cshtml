@model IEnumerable<PlaylistDetailViewModel>
@{ ViewData["Title"] = "My Playlists"; }

<div class="page-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0">My Playlists</h1>
        <a asp-action="Create" class="btn btn-tantar">
            <i class="bi bi-plus me-1"></i>New Playlist
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-collection text-secondary" style="font-size:3rem"></i>
            <p class="text-secondary mt-3">You haven't created any playlists yet.</p>
            <a asp-action="Create" class="btn btn-tantar">Create your first playlist</a>
        </div>
    }
    else
    {
        <div class="grid-cards">
            @foreach (var p in Model)
            {
                <a asp-action="Details" asp-route-id="@p.Id"
                   class="tantar-card text-decoration-none text-white">
                    <img src="@(p.CoverImagePath ?? "/images/default-cover.svg")"
                         alt="@p.Name" class="tantar-card-cover" />
                    <div class="fw-semibold text-truncate">@p.Name</div>
                    <div class="small text-secondary">@p.Songs.Count song@(p.Songs.Count != 1 ? "s" : "") · @(p.IsPublic ? "Public" : "Private")</div>
                </a>
            }
        </div>
    }
</div>
