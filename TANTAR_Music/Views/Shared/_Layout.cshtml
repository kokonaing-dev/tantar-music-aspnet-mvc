@using Microsoft.AspNetCore.Identity
@using TANTAR_Music.Models.Domain
@inject UserManager<ApplicationUser> UserManager

@{
    ApplicationUser? currentUser = null;
    if (User.Identity?.IsAuthenticated == true)
        currentUser = await UserManager.GetUserAsync(User);

    var userAvatar = currentUser?.ProfileImagePath ?? "/images/default-user.svg";
    var displayName = currentUser?.DisplayName ?? currentUser?.Email ?? User.Identity?.Name ?? "";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – TANTAR Music</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="tantar-body">

<div class="tantar-layout">
    <!-- Sidebar -->
    <nav class="tantar-sidebar d-flex flex-column p-3">
        <a class="tantar-logo mb-4 text-decoration-none" asp-controller="Home" asp-action="Index">
            <i class="bi bi-music-note-beamed me-2 text-success"></i><span class="fw-bold fs-5">TANTAR</span>
        </a>

        <ul class="nav flex-column gap-1 mb-4">
            <li class="nav-item">
                <a class="nav-link tantar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-fill me-2"></i>Home
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link tantar-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Search" ? "active" : "")"
                   asp-controller="Home" asp-action="Search">
                    <i class="bi bi-search me-2"></i>Search
                </a>
            </li>
        </ul>

        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
            <span class="text-secondary small fw-semibold text-uppercase">Your Library</span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Playlist" asp-action="Create" class="btn btn-sm btn-dark rounded-circle p-1 lh-1" title="New Playlist">
                    <i class="bi bi-plus-lg small"></i>
                </a>
            }
        </div>

        <ul class="nav flex-column gap-1 mb-4">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="nav-item">
                    <a class="nav-link tantar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Playlist" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       asp-controller="Playlist" asp-action="Index">
                        <i class="bi bi-collection-fill me-2"></i>My Playlists
                    </a>
                </li>
            }
            <li class="nav-item">
                <a class="nav-link tantar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Playlist" && ViewContext.RouteData.Values["action"]?.ToString() == "Public" ? "active" : "")"
                   asp-controller="Playlist" asp-action="Public">
                    <i class="bi bi-globe me-2"></i>Public Playlists
                </a>
            </li>
        </ul>

        <hr class="border-secondary opacity-25" />

        <ul class="nav flex-column gap-1">
            <li class="nav-item">
                <a class="nav-link tantar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Artist" ? "active" : "")"
                   asp-controller="Artist" asp-action="Index">
                    <i class="bi bi-person-badge me-2"></i>Artists
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link tantar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Album" ? "active" : "")"
                   asp-controller="Album" asp-action="Index">
                    <i class="bi bi-disc me-2"></i>Albums
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link tantar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Song" ? "active" : "")"
                   asp-controller="Song" asp-action="Index">
                    <i class="bi bi-music-note-list me-2"></i>Songs
                </a>
            </li>
        </ul>

        <div class="mt-auto pt-3 border-top border-secondary">
            @if (currentUser != null)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <img src="@userAvatar" alt="@displayName"
                         class="rounded-circle"
                         style="width:32px;height:32px;object-fit:cover;flex-shrink:0" />
                    <span class="small text-truncate">@displayName</span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-light w-100 mb-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Login
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-success w-100">Sign Up</a>
            }
        </div>
    </nav>

    <!-- Main content -->
    <main class="tantar-main">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3 mb-0" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>
</div>

<!-- Global CSRF token for AJAX -->
@Html.AntiForgeryToken()

<!-- Add to Playlist Modal -->
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="modal fade" id="addToPlaylistModal" tabindex="-1" aria-labelledby="addToPlaylistLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:320px">
            <div class="modal-content border-secondary" style="background:#282828">
                <div class="modal-header border-secondary py-2">
                    <h6 class="modal-title fw-bold" id="addToPlaylistLabel">
                        <i class="bi bi-plus-circle me-2 text-success"></i>Add to playlist
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0" id="playlist-modal-body">
                    <div class="text-center py-4 text-secondary small">Loading…</div>
                </div>
                <div class="modal-footer border-secondary py-2">
                    <a asp-controller="Playlist" asp-action="Create" class="btn btn-sm btn-tantar w-100">
                        <i class="bi bi-plus me-1"></i>New playlist
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- Persistent Music Player -->
<div id="music-player" class="tantar-player" style="display:none;">
    <audio id="audio-engine"></audio>
    <div class="d-flex align-items-center gap-3 h-100 px-4">
        <!-- Song info -->
        <div class="d-flex align-items-center gap-3 player-info">
            <img id="player-cover" src="/images/default-cover.svg" alt="Cover" class="player-cover rounded" />
            <div class="overflow-hidden">
                <div id="player-title" class="fw-semibold text-truncate small"></div>
                <div id="player-artist" class="text-secondary small text-truncate"></div>
            </div>
        </div>

        <!-- Controls -->
        <div class="d-flex flex-column align-items-center flex-grow-1 gap-1">
            <div class="d-flex align-items-center gap-3">
                <button id="btn-prev" title="Previous">
                    <i class="bi bi-skip-start-fill"></i>
                </button>
                <button id="btn-play-pause" title="Play/Pause">
                    <i class="bi bi-play-fill" id="play-icon"></i>
                </button>
                <button id="btn-next" title="Next">
                    <i class="bi bi-skip-end-fill"></i>
                </button>
            </div>
            <div class="d-flex align-items-center gap-2 w-100">
                <span id="player-current" class="small text-secondary" style="min-width:38px;text-align:right">0:00</span>
                <input type="range" id="player-seek" class="form-range flex-grow-1" value="0" step="1" />
                <span id="player-duration" class="small text-secondary" style="min-width:38px">0:00</span>
            </div>
        </div>

        <!-- Volume -->
        <div class="d-flex align-items-center gap-2 player-volume">
            <i class="bi bi-volume-up-fill text-secondary"></i>
            <input type="range" id="player-volume" class="form-range" value="80" min="0" max="100"
                   style="width:90px" />
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/player.js" asp-append-version="true"></script>
<script src="~/js/playlist-actions.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
